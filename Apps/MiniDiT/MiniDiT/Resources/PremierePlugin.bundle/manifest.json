{
  "manifestVersion": 5,
  "id": "com.kong.minidit.premiere.direct",
  "name": "MiniDiT",
  "version": "1.0.0",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "25.6.0" },
  "requiredPermissions": { "localFileSystem": "fullAccess" },
  "entrypoints": [{
    "id": "minidit", "type": "panel", "label": { "default": "MiniDiT" },
    "minimumSize": { "width": 260, "height": 160 },
    "preferredDockedSize": { "width": 300, "height": 180 },
    "preferredFloatingSize": { "width": 360, "height": 220 }
  }]
}
