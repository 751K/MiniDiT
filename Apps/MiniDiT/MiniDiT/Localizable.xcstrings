          }
        }
      }
    },
    "按 assets.list 中的拍摄 ID 选择素材。只允许选择当前可见范围，mode 默认为 replace；不下载文件。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selects media by the shot IDs from assets.list. Only the currently visible scope can be selected; mode defaults to replace. Does not download files."
          }
        }
      }
    },
    "按 projects.list 返回的 UUID 选择导入项目。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selects the import project by a UUID returned by projects.list."
          }
        }
      }
